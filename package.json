{
  "name": "@clearsign/react",
  "version": "0.1.0",
  "description": "Soroban Clear-Sign Kit - React hooks and UI components for transaction clear-signing",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "sideEffects": [
    "dist/index.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters/freighter": {
      "import": {
        "types": "./dist/adapters/freighter.d.ts",
        "default": "./dist/adapters/freighter.js"
      },
      "require": {
        "types": "./dist/adapters/freighter.d.cts",
        "default": "./dist/adapters/freighter.cjs"
      }
    },
    "./adapters/stellar-wallets-kit": {
      "import": {
        "types": "./dist/adapters/stellar-wallets-kit.d.ts",
        "default": "./dist/adapters/stellar-wallets-kit.js"
      },
      "require": {
        "types": "./dist/adapters/stellar-wallets-kit.d.cts",
        "default": "./dist/adapters/stellar-wallets-kit.cjs"
      }
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --filter example dev",
    "build": "tsup",
    "build:example": "pnpm --filter example build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:tarball": "node scripts/test-packed-tarball.mjs",
    "check:package": "publint && attw --pack . --exclude-entrypoints ./styles.css ./package.json",
    "check:size": "size-limit"
  },
  "dependencies": {
    "@clearsign/core": "^0.1.0",
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "peerDependencies": {
    "@creit.tech/stellar-wallets-kit": ">=1.0.0",
    "@stellar/freighter-api": ">=1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@stellar/freighter-api": {
      "optional": true
    },
    "@creit.tech/stellar-wallets-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "@stellar/freighter-api": "^6.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^14.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.1",
    "vitest-axe": "^0.1.0"
  },
  "files": [
    "dist",
    "adapters"
  ]
}
