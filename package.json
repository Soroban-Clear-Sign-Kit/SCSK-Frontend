{
  "name": "@clearsign/react",
  "version": "0.1.0",
  "description": "Soroban Clear-Sign Kit - React hooks and UI components for transaction clear-signing",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/freighter": {
      "types": "./dist/adapters/freighter.d.ts",
      "import": "./dist/adapters/freighter.js",
      "require": "./dist/adapters/freighter.cjs"
    },
    "./adapters/stellar-wallets-kit": {
      "types": "./dist/adapters/stellar-wallets-kit.d.ts",
      "import": "./dist/adapters/stellar-wallets-kit.js",
      "require": "./dist/adapters/stellar-wallets-kit.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format:check": "prettier --check .",
    "test": "vitest run --dir test",
    "test:coverage": "vitest run --coverage --dir test"
  },
  "dependencies": {
    "@clearsign/core": "link:../SCSK-Backend",
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@stellar/freighter-api": ">=1.0.0",
    "@creit.tech/stellar-wallets-kit": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@stellar/freighter-api": {
      "optional": true
    },
    "@creit.tech/stellar-wallets-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stellar/freighter-api": "^6.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.1",
    "vitest-axe": "^0.1.0"
  },
  "files": [
    "dist"
  ]
}
